        "### create a data matrix for the barplot\n",
        "data_matrix <- rbind(\n",
        "  g_data_subset$non_coding_gene_count,\n",
        "  g_data_subset$protein_coding_gene_count\n",
        ")\n",
        "\n",
        "### create the stacked barplot\n",
        "barplot(\n",
        "  data_matrix,\n",
        "  col = c(\"darkcyan\", \"mediumpurple3\"),\n",
        "  beside = FALSE,\n",
        "  legend.text = c(\"Non-coding genes\", \"Protein-coding genes\"),\n",
        "  main = \"Protein-Coding and Non-Coding Genes per Organism\",\n",
        "  names.arg = g_data_subset$organism,\n",
        "  xlab = \"Organism\",\n",
        "  ylab = \"Number of Genes\",\n",
        "  cex.names = 0.7,\n",
        "  cex.axis = 0.7\n",
        ")"
