    {
      "cell_type": "code",
      "source": [
        "lines <- readLines(\"assembly_summary_refseq.txt\")"
      ],
      "metadata": {
        "id": "qLEBnGQOK7QS"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "cleaned_lines <- gsub(\"#\", \"\", lines)"
      ],
      "metadata": {
        "id": "_n0tE882K_yX"
      },
      "execution_count": 5,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "### convert cleaned lines to a data frame, skip first line, and use quote = \"\" to avoid issues with unmatched quotes\n",
        "g_data <- read.table(text = cleaned_lines, sep = \"\\t\", skip = 1, header = TRUE, fill = TRUE, quote = \"\")\n",
        "\n",
        "### export the edited data frame to a new file\n",
        "write.table(g_data, \"assembly_summary_refseq_cleaned.txt\", sep = \"\\t\", row.names = FALSE, quote = FALSE)\n"
      ],
      "metadata": {
        "id": "UK9jkOH5LHTX"
      },
      "execution_count": 6,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "### count number of columns (variables) and rows (observations=genomes)\n",
        "nrow(g_data)\n",
        "ncol(g_data)\n",
        "\n",
        "### count number of genemoes for each major lineage\n",
        "genome_counts <- table(g_data$group)\n",
        "\n",
        "### display the result\n",
        "print(genome_counts)\n",
        "\n",
        "### summary statistics of gc percent\n",
        "summary(g_data$gc_percent)\n",
        "\n",
        "### statistical messures of gc percent\n",
        "mean(g_data$gc_percent)\n",
        "median(g_data$gc_percent)\n",
        "min(g_data$gc_percent)\n",
        "max(g_data$gc_percent)"
      ],
