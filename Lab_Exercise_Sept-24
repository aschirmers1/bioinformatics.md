      "source": [
        "writeLines(\n",
        "'library(ggplot2)\n",
        "\n",
        "### Create modified GC content histogram\n",
        "gc_plot <- ggplot(g_data, aes(x = gc_percent)) +\n",
        "  geom_histogram(\n",
        "    fill = \"pink\",\n",
        "    color = \"black\",\n",
        "    bins = 30\n",
        "  ) +\n",
        "  labs(\n",
        "    title = \"Distribution of GC Content\",\n",
        "    x = \"GC Percent\",\n",
        "    y = \"Count\"\n",
        "  ) +\n",
        "  theme_classic()\n",
        "\n",
        "gc_plot\n",
        "\n",
        "### Save figure as PDF\n",
        "ggsave(\n",
        "  \"GC_content_histogram.pdf\",\n",
        "  plot = gc_plot,\n",
        "  width = 8,\n",
        "  height = 6\n",
        ")',\n",
        "\"GC_content_histogram.R\"\n",
